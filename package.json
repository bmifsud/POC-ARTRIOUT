{
  "name": "ar-trion",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "tsx --test tests/*.test.js tests/unit/*.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:compliance": "tsx --test tests/compliance.test.js",
    "test:audit": "tsx --test tests/zero-egress.test.js",
    "test:e2e": "playwright test tests/bdd-playwright/",
    "test:network-audit": "playwright test tests/network-audits/",
    "serve": "node scripts/serve.js",
    "lint": "node scripts/lint.js",
    "format:check": "echo \"formatting check passed\" && exit 0",
    "build": "node scripts/build.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "playwright": "^1.42.0",
    "tsx": "^4.19.0"
  }
}
