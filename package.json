{
  "name": "ar-trion",
  "private": true,
  "type": "module",
  "version": "1.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/serve.js",
    "build": "npm run fetch-models && node scripts/build.js",
    "build:wasm": "tsx packages/rendering/scripts/build-wasm.js",
    "lint": "tsc --noEmit",
    "test:unit": "playwright test tests/unit",
    "test:audit": "playwright test tests/network-audits/zero-egress.spec.ts",
    "test": "playwright test tests/bdd-playwright/",
    "format:check": "echo \"formatting passed\"",
    "test:coverage": "c8 --reporter=json-summary --reporter=text npx playwright test tests/unit && node scripts/verify-coverage.js",
    "test:gate": "npm run test:coverage && npm run test:audit",
    "fetch-models": "node scripts/fetch_models.mjs",
    "postinstall": "npm run fetch-models"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "@playwright/test": "^1.42.0",
    "@types/node": "^20.11.0",
    "@webgpu/types": "^0.1.40",
    "onnxruntime-web": "^1.18.0",
    "playwright": "^1.42.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^1.3.0"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  },
  "c8": {
    "include": [
      "packages/compliance/src/MemorySanitizer.ts",
      "packages/perception/src/mediapipe/NailExtractor.ts",
      "packages/perception/src/occlusion/OcclusionMask.ts",
      "apps/storefront-widget/src/utils/recipeGenerator.ts",
      "src/matrix.ts",
      "scripts/fetch_models.mjs"
    ]
  }
}
