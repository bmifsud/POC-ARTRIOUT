{
  "name": "ar-trion",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "tsx --test tests/*.test.js tests/unit/*.test.ts tests/unit/*.spec.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts tests/unit/*.spec.ts",
    "test:compliance": "tsx --test tests/compliance.test.js",
    "test:audit": "playwright test tests/network-audits/",
    "test:e2e": "playwright test tests/bdd-playwright/",
    "test:network-audit": "playwright test tests/network-audits/",
    "serve": "node scripts/serve.js",
    "lint": "node scripts/lint.js",
    "format:check": "echo \"formatting check passed\" && exit 0",
    "build": "node scripts/build.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@size-limit/preset-app": "^8.2.6",
    "playwright": "^1.42.0",
    "size-limit": "^8.2.6",
    "tsx": "^4.19.0"
  },
  "size-limit": [
    {
      "path": "dist/index.html",
      "limit": "1000 ms"
    }
  ]
}
